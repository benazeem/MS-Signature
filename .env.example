NEON_DATABASE_URL="postgresql://[USER]:[PASSWORD]@[PROJECT-POOLER].neon.tech/[DATABASE]?sslmode=require"
NEON_DIRECT_URL="postgresql://[USER]:[PASSWORD]@[PROJECT].neon.tech/[DATABASE]?sslmode=require"

DATABASE_URL="postgresql://[USER]:[PASSWORD]@[PROJECT-POOLER].neon.tech/[DATABASE]?sslmode=require"
DIRECT_URL="postgresql://[USER]:[PASSWORD]@[PROJECT].neon.tech/[DATABASE]?sslmode=require"


# Email â€” Development (Mailtrap.io SMTP)
# Neon Auth
NEON_AUTH_BASE_URL="https://[YOUR-NEON-AUTH-HOST]/[DATABASE]/auth"
NEON_AUTH_JWKS_URL="https://[YOUR-NEON-AUTH-HOST]/[DATABASE]/auth/.well-known/jwks.json"
# Get from: https://mailtrap.io â†’ Inboxes â†’ SMTP Settings
NODEMAILER_HOST=sandbox.smtp.mailtrap.io
NODEMAILER_PORT=2525
NODEMAILER_USER=your-mailtrap-username
NODEMAILER_PASS=your-mailtrap-password
EMAIL_FROM="MS Signature Scents <noreply@mssignaturescents.com>"
NODE_ENV=development

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=your-sanity-project-id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your-sanity-api-token

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
